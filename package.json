{
  "name": "system-whitepaper-skill",
  "version": "0.0.0",
  "private": true,
  "files": [
    "SKILL.md",
    "agents/",
    "docs/narrative-guide.md",
    "evidence-schema.md",
    "explorer-guide.md",
    "form-fill-rules.md",
