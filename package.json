    "safety-rules.md",
    "whitepaper-template.md",
    "examples/",
    "scripts/build-evidence-summary.js",
    "scripts/approval-guard.js",
    "scripts/build-database-model.js",
    "scripts/build-business-process-model.js",
    "scripts/build-function-universe.js",
    "scripts/build-workflow-spec.js",
    "scripts/build-operation-spec.js",
    "scripts/build-verified-claims.js",
    "scripts/check-agent-isolation.js",
    "scripts/check-narrative.js",
    "scripts/check-quality.js",
    "scripts/check-batch-acceptance.js",
    "scripts/check-delivery-readiness.js",
    "scripts/check-real-run-readiness.js",
    "scripts/check-truth-readiness.js",
    "scripts/collect-evidence.js",
    "scripts/collect-database-profile.js",
    "scripts/export-whitepaper-word.js",
    "scripts/generate-operation-guide.js",
    "scripts/generate-whitepaper.js",
    "scripts/generate-write-validation-plan.js",
    "scripts/doctor.js",
    "scripts/fact-check-whitepaper.js",
    "scripts/init-local-config.js",
    "scripts/local-dashboard/",
    "scripts/menu-list-capture.js",
    "scripts/narrative/",
    "scripts/operation-spec/",
    "scripts/pipeline-state.js",
    "scripts/prepare-agent-worktrees.js",
    "scripts/refresh-huntian-cookie.js",
    "scripts/run-phase3b.js",
    "scripts/run-review-decision.js",
    "scripts/run-local-e2e-smoke.js",
    "scripts/repair-artifacts.js",
    "scripts/run-batch-repair-queue.js",
    "scripts/run-repair-follow-up-loop.js",
    "scripts/run-golden-eval.js",
    "scripts/run-whitepaper-batch.js",
    "scripts/run-whitepaper-pipeline.js",
    "scripts/start-dashboard.ps1",
    "scripts/sync-systems-registry.js",
    "scripts/system-whitepaper-lib.js",
    "scripts/system-whitepaper.test.js",
    "scripts/systems-registry.js",
    "scripts/validate-write.js",
    "启动白皮书看板.bat"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node scripts/system-whitepaper.test.js",
    "pack:check": "npm pack --dry-run --json --cache .npm-cache",
    "init": "node scripts/init-local-config.js",
    "doctor": "node scripts/doctor.js --config config/systems.local.yaml",
    "agent:isolation": "node scripts/check-agent-isolation.js --plan .agents/4-agent-plan.json --expected-workers 4",
    "agent:worktrees": "node scripts/prepare-agent-worktrees.js --plan .agents/4-agent-plan.json --expected-workers 4",
    "agent:isolation:worktrees": "node scripts/check-agent-isolation.js --plan .agents/4-agent-plan.json --expected-workers 4 --verify-worktrees --require-clean-coordinator",
    "agent:isolation:strict": "node scripts/check-agent-isolation.js --plan .agents/4-agent-plan.json --expected-workers 4 --verify-worktrees --require-handoffs --require-clean-coordinator",
    "db:profile": "node scripts/collect-database-profile.js --config config/systems.local.yaml",
    "db:model": "node scripts/build-database-model.js",
    "workflow:spec": "node scripts/build-workflow-spec.js",
    "truth:universe": "node scripts/build-function-universe.js",
    "truth:claims": "node scripts/build-verified-claims.js",
    "truth:fact-check": "node scripts/fact-check-whitepaper.js",
    "truth:readiness": "node scripts/check-truth-readiness.js --config config/systems.local.yaml",
    "batch:acceptance": "node scripts/check-batch-acceptance.js --config config/systems.local.yaml",
    "delivery:check": "node scripts/check-delivery-readiness.js --config config/systems.local.yaml",
    "real:check": "node scripts/check-real-run-readiness.js --config config/systems.local.yaml",
    "sync": "node scripts/sync-systems-registry.js --config config/systems.local.yaml",
    "dashboard": "node scripts/local-dashboard/server.js --config config/systems.local.yaml --port 3920",
    "phase3b": "node scripts/run-phase3b.js --config config/systems.local.yaml",
    "pipeline": "node scripts/run-whitepaper-pipeline.js --config config/systems.local.yaml",
    "batch": "node scripts/run-whitepaper-batch.js --config config/systems.local.yaml --with-whitepaper --concurrency 4",
    "repair:batch": "node scripts/run-batch-repair-queue.js --config config/systems.local.yaml --concurrency 4",
    "repair:loop": "node scripts/run-repair-follow-up-loop.js --config config/systems.local.yaml --concurrency 4"
  },
  "dependencies": {
    "@cursor/sdk": "^1.0.13",
    "playwright": "^1.60.0",
    "xlsx": "^0.18.5"
  }
}
